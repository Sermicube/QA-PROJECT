FROM python:3.12-slim

WORKDIR /app

# Instalar solo dependencias del núcleo (sin tesseract/scipy/opencv que se usan en fases posteriores)
RUN pip install --no-cache-dir \
    "fastapi>=0.115" \
    "uvicorn[standard]>=0.30" \
    "pydantic>=2.7" \
    "pydantic-settings>=2.3" \
    "sqlalchemy[asyncio]>=2.0" \
    "asyncpg>=0.29" \
    "psycopg2-binary>=2.9" \
    "alembic>=1.13" \
    "celery[redis]>=5.4" \
    "redis>=5.0" \
    "python-docx>=1.1" \
    "pdfplumber>=0.11" \
    "pandas>=2.2" \
    "openpyxl>=3.1" \
    "xlrd>=2.0" \
    "holidays>=0.51" \
    "scipy>=1.13" \
    "python-dateutil>=2.9" \
    "jinja2>=3.1" \
    "anthropic>=0.34" \
    "httpx>=0.27" \
    "argon2-cffi>=23.1" \
    "PyJWT>=2.9" \
    "structlog>=24.4" \
    "python-multipart>=0.0.12" \
    "email-validator>=2.1" \
    "Pillow>=10.4" \
    "PyYAML>=6.0" \
    "pytest>=8.3" \
    "pytest-asyncio>=0.24"

# El código fuente se monta en runtime vía volume — no se copia aquí
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
